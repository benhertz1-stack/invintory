# Copy to .env for local development. Never commit .env.

# Wine Advisor / sommelier notes (server-side Anthropic calls)
ANTHROPIC_API_KEY=sk-ant-...

# Single-owner auth. Generate both with:  npm run passphrase
OWNER_PASSPHRASE_HASH=scrypt$16384$...$...
AUTH_SECRET=...

# Firestore project (uses gcloud Application Default Credentials locally)
GOOGLE_CLOUD_PROJECT=invintory-495823

# Public origin used in links handed to Claude (dev: the Vite URL). Unset in Cloud Run.
PUBLIC_BASE_URL=http://localhost:5173

