# Copy to .env for local development. Never commit .env.

# Wine Advisor / sommelier notes (server-side Anthropic calls)
ANTHROPIC_API_KEY=sk-ant-...

# Single-owner auth. Generate both with:  npm run passphrase
OWNER_PASSPHRASE_HASH=scrypt$16384$...$...
AUTH_SECRET=...

# Firestore project (uses gcloud Application Default Credentials locally)
GOOGLE_CLOUD_PROJECT=invintory-495823

# Public origin used in links handed to Claude (dev: the Vite URL). Unset in Cloud Run.
PUBLIC_BASE_URL=http://localhost:5173

# PORT=3001

# Monthly report (server/report.ts)
# Shared secret Cloud Scheduler sends as X-Report-Key to POST /api/reports/run
REPORT_KEY=...
# Where the report goes (defaults to SMTP_USER)
REPORT_TO=you@example.com
# Gmail: SMTP_USER = your Gmail address, SMTP_PASS = an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
