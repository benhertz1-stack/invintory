{
  "name": "invintory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon --watch server -e ts --exec tsx server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "passphrase": "tsx server/passphrase.ts",
    "migrate": "tsx server/migrate.ts",
    "mcp:stdio": "tsx server/mcp.ts",
    "unlock": "tsx scripts/unlock-login.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.17.0",
    "@types/three": "^0.184.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "firebase-admin": "^13.9.0",
    "lucide-react": "^1.37.0",
    "nodemailer": "^9.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.21.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "three": "^0.184.0",
    "tsx": "^4.22.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
